OPENAI_API_KEY="sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
PORT=3000

# ── Authentification par lien magique (email) ──
# Clé secrète utilisée pour signer les jetons de connexion et de session.
# Génère une valeur aléatoire longue et unique, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# URL de base de l'application (utilisée pour construire le lien envoyé par email — pointe vers le backend)
APP_URL=https://jury-ia.fr

# URL du frontend vers laquelle rediriger une fois connecté.
# En local : http://localhost:5173 (Vite). En production : identique à APP_URL.
FRONTEND_URL=https://jury-ia.fr

# ── Resend (envoi d'emails) ──
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Google Sheets (liste des clients : email + date d'expiration) ──
# URL du Sheet publié sur le web au format CSV (Fichier > Partager > Publier sur le web)
GOOGLE_SHEET_CSV_URL="https://docs.google.com/spreadsheets/d/e/2PACX-1vTfUnI8PEnp4PtMDRMMLLLEFiUSW3CUovVG9eBUvRRKnechhTVWy5pU9iGNkOQyOrKTvimiO7B1g8A3/pub?gid=0&single=true&output=csv"
